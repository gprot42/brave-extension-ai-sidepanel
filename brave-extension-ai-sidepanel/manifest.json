{
  "name": "Gemini Docs Side Panel",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Gemini AI side panel for Google Docs with live document and comments context",
  "permissions": ["sidePanel", "storage", "activeTab"],
  "host_permissions": ["https://docs.google.com/*", "https://drive.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Gemini Side Panel"
  }
}
